<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>TradePro — Simulated Trading</title>
<style>
  :root {
    --bg: #0b0e11;
    --bg-elevated: #151a21;
    --surface: #1a1f27;
    --surface-hover: #222833;
    --border: #2a303a;
    --border-light: #3a4150;
    --text-primary: #e8ecf1;
    --text-secondary: #8b95a5;
    --text-muted: #5a6270;
    --accent: #00c853;
    --accent-dim: rgba(0,200,83,0.15);
    --accent-sell: #ff5252;
    --accent-sell-dim: rgba(255,82,82,0.15);
    --positive: #00c853;
    --negative: #ff5252;
    --warning: #ffb300;
    --chart-up: #00c853;
    --chart-down: #ff5252;
  }

  [data-theme="light"] {
    --bg: #f5f6f8;
    --bg-elevated: #ffffff;
    --surface: #ffffff;
    --surface-hover: #f0f1f4;
    --border: #e1e4e8;
    --border-light: #d0d4da;
    --text-primary: #1a1d23;
    --text-secondary: #6b7280;
    --text-muted: #9ca3af;
    --accent: #059669;
    --accent-dim: rgba(5,150,105,0.12);
    --accent-sell: #dc2626;
    --accent-sell-dim: rgba(220,38,38,0.12);
    --positive: #059669;
    --negative: #dc2626;
    --warning: #d97706;
    --chart-up: #059669;
    --chart-down: #dc2626;
  }

  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; margin: 0; padding: 0; }
  html, body { height: 100%; overflow: hidden; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Segoe UI", Roboto, sans-serif;
    background: var(--bg);
    color: var(--text-primary);
    display: flex;
    flex-direction: column;
    height: 100vh;
    transition: background 0.3s ease, color 0.3s ease;
    -webkit-font-smoothing: antialiased;
  }

  .scroll {
    flex: 1;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    padding: 0 16px;
    padding-bottom: 100px;
  }

  .header {
    padding: 16px 16px 8px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border);
    background: var(--bg);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .logo {
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.5px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .logo-icon {
    width: 28px; height: 28px;
    background: linear-gradient(135deg, var(--accent), #00e676);
    border-radius: 6px;
    display: flex; align-items: center; justify-content: center;
    font-size: 14px; font-weight: 900; color: #fff;
  }
  .market-pill {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 20px;
    background: var(--surface);
    border: 1px solid var(--border);
    font-size: 12px;
    font-weight: 600;
    color: var(--text-secondary);
  }
  .market-pill .dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--positive);
    box-shadow: 0 0 6px var(--positive);
  }
  .market-pill .dot.closed {
    background: var(--negative);
    box-shadow: 0 0 6px var(--negative);
  }

  .dashboard {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    margin: 16px 0;
  }
  .dash-cell {
    background: var(--surface);
    padding: 16px 12px;
    text-align: center;
  }
  .dash-cell .label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: var(--text-secondary);
    margin-bottom: 6px;
    font-weight: 600;
  }
  .dash-cell .value {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.3px;
    font-variant-numeric: tabular-nums;
  }
  .dash-cell .sub {
    font-size: 12px;
    margin-top: 4px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 4px 12px;
  }
  .section-title {
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: var(--text-secondary);
  }
  .section-count {
    font-size: 12px;
    color: var(--text-muted);
    font-weight: 600;
  }

  .quotes-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }
  .quotes-table thead th {
    text-align: left;
    padding: 10px 8px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
  }
  .quotes-table thead th:last-child,
  .quotes-table tbody td:last-child { text-align: right; }
  .quotes-table thead th:nth-child(3),
  .quotes-table tbody td:nth-child(3) { text-align: right; }
  .quotes-table thead th:nth-child(4),
  .quotes-table tbody td:nth-child(4) { text-align: right; }
  .quotes-table thead th:nth-child(5),
  .quotes-table tbody td:nth-child(5) { text-align: right; }
  .quotes-table thead th:nth-child(6),
  .quotes-table tbody td:nth-child(6) { text-align: right; }
  .quotes-table tbody tr {
    border-bottom: 1px solid var(--border);
    transition: background 0.15s ease;
    cursor: pointer;
  }
  .quotes-table tbody tr:active { background: var(--surface-hover); }
  .quotes-table tbody td {
    padding: 14px 8px;
    vertical-align: middle;
  }
  .q-ticker {
    font-weight: 700;
    font-size: 14px;
    letter-spacing: -0.2px;
  }
  .q-name {
    font-size: 11px;
    color: var(--text-secondary);
    margin-top: 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100px;
  }
  .q-price {
    font-weight: 700;
    font-size: 14px;
    font-variant-numeric: tabular-nums;
  }
  .q-change {
    font-weight: 600;
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }
  .q-mktcap, .q-range {
    font-size: 12px;
    color: var(--text-secondary);
    font-variant-numeric: tabular-nums;
  }

  .portfolio-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 14px 16px;
    margin-bottom: 8px;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 8px;
    align-items: center;
  }
  .port-left { display: flex; flex-direction: column; gap: 3px; }
  .port-ticker { font-weight: 700; font-size: 14px; }
  .port-meta { font-size: 12px; color: var(--text-secondary); font-variant-numeric: tabular-nums; }
  .port-right { text-align: right; display: flex; flex-direction: column; gap: 3px; }
  .port-value { font-weight: 700; font-size: 14px; font-variant-numeric: tabular-nums; }
  .port-pl { font-size: 12px; font-weight: 600; font-variant-numeric: tabular-nums; }

  .order-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 20px 16px;
    margin-bottom: 16px;
  }
  .order-tabs {
    display: flex;
    gap: 0;
    margin-bottom: 20px;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--border);
  }
  .order-tab {
    flex: 1;
    padding: 12px;
    border: none;
    background: var(--bg-elevated);
    color: var(--text-secondary);
    font-weight: 700;
    font-size: 14px;
    cursor: pointer;
    transition: all 0.2s;
    -webkit-user-select: none;
    user-select: none;
  }
  .order-tab.active.buy { background: var(--accent-dim); color: var(--accent); }
  .order-tab.active.sell { background: var(--accent-sell-dim); color: var(--accent-sell); }

  .order-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 0;
    border-bottom: 1px solid var(--border);
  }
  .order-row:last-child { border-bottom: none; }
  .order-label {
    font-size: 14px;
    color: var(--text-secondary);
    font-weight: 500;
  }
  .order-value {
    font-size: 14px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .input-field {
    width: 100%;
    padding: 14px 16px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    color: var(--text-primary);
    font-size: 16px;
    font-weight: 600;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
    -webkit-appearance: none;
    margin-top: 6px;
  }
  .input-field:focus {
    border-color: var(--border-light);
    box-shadow: 0 0 0 3px rgba(255,255,255,0.05);
  }
  .input-group { margin-bottom: 16px; }
  .input-group label {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: var(--text-secondary);
    font-weight: 600;
  }

  .order-type-row {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
  }
  .type-btn {
    flex: 1;
    padding: 10px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    color: var(--text-secondary);
    font-weight: 600;
    font-size: 13px;
    text-align: center;
    cursor: pointer;
    transition: all 0.2s;
    -webkit-user-select: none;
    user-select: none;
  }
  .type-btn.active {
    background: var(--surface-hover);
    color: var(--text-primary);
    border-color: var(--border-light);
  }

  .submit-btn {
    width: 100%;
    padding: 16px;
    border-radius: 10px;
    border: none;
    font-size: 15px;
    font-weight: 700;
    color: #fff;
    cursor: pointer;
    transition: all 0.2s ease;
    margin-top: 8px;
    letter-spacing: 0.3px;
    -webkit-user-select: none;
    user-select: none;
  }
  .submit-btn.buy { background: var(--accent); }
  .submit-btn.sell { background: var(--accent-sell); }
  .submit-btn:active { opacity: 0.85; transform: scale(0.98); }
  .submit-btn:disabled { opacity: 0.4; cursor: not-allowed; }

  .estimate-row {
    display: flex;
    justify-content: space-between;
    padding: 10px 0;
    font-size: 13px;
  }
  .estimate-label { color: var(--text-secondary); }
  .estimate-value { font-weight: 600; font-variant-numeric: tabular-nums; }

  .bottom-bar {
    position: fixed;
    bottom: 0; left: 0; right: 0;
    padding: 12px 16px 28px;
    background: var(--bg);
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: center;
    z-index: 100;
  }
  .settings-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-secondary);
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
    transition: all 0.2s;
    -webkit-user-select: none;
    user-select: none;
  }
  .settings-btn:active { background: var(--surface-hover); }

  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.6);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    display: none;
    align-items: flex-end;
    justify-content: center;
    z-index: 200;
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .modal-overlay.open { display: flex; opacity: 1; }
  .modal-sheet {
    width: 100%;
    max-width: 500px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 20px 20px 0 0;
    padding: 24px 20px 40px;
    transform: translateY(100%);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .modal-overlay.open .modal-sheet { transform: translateY(0); }
  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
  }
  .modal-title { font-size: 18px; font-weight: 700; }
  .modal-close {
    width: 32px; height: 32px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    color: var(--text-primary);
    font-size: 20px;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
  }
  .setting-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 0;
    border-bottom: 1px solid var(--border);
  }
  .setting-label { font-weight: 600; font-size: 15px; }
  .setting-desc { font-size: 12px; color: var(--text-secondary); margin-top: 3px; }

  .toggle {
    width: 50px; height: 28px;
    border-radius: 14px;
    background: var(--border-light);
    position: relative;
    cursor: pointer;
    transition: background 0.25s ease;
    flex-shrink: 0;
  }
  .toggle.on { background: var(--accent); }
  .toggle-knob {
    width: 24px; height: 24px;
    border-radius: 50%;
    background: #fff;
    position: absolute;
    top: 2px; left: 2px;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 1px 4px rgba(0,0,0,0.2);
  }
  .toggle.on .toggle-knob { transform: translateX(22px); }

  .danger-btn {
    width: 100%;
    padding: 14px;
    border-radius: 10px;
    border: 1px solid var(--negative);
    background: transparent;
    color: var(--negative);
    font-weight: 700;
    font-size: 14px;
    cursor: pointer;
    margin-top: 20px;
    transition: all 0.2s;
  }
  .danger-btn:active { background: var(--accent-sell-dim); }

  .toast {
    position: fixed;
    top: 16px; left: 50%;
    transform: translateX(-50%) translateY(-120px);
    padding: 12px 20px;
    border-radius: 10px;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text-primary);
    font-weight: 600;
    font-size: 13px;
    z-index: 300;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 8px 24px rgba(0,0,0,0.3);
    text-align: center;
    max-width: 90vw;
    pointer-events: none;
  }
  .toast.show { transform: translateX(-50%) translateY(0); }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-in { animation: fadeIn 0.3s ease forwards; }

  input[type=number]::-webkit-inner-spin-button,
  input[type=number]::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
</style>
</head>
