  {t:'META',n:'Meta',p:505.68,mc:'1.30T',dh:510.00,dl:500.25},
  {t:'NFLX',n:'Netflix',p:628.90,mc:'275B',dh:635.00,dl:622.00},
  {t:'AMD',n:'AMD',p:164.75,mc:'266B',dh:167.00,dl:162.50},
  {t:'INTC',n:'Intel',p:43.12,mc:'184B',dh:43.80,dl:42.60},
  {t:'DIS',n:'Disney',p:112.40,mc:'205B',dh:114.00,dl:111.00},
  {t:'BA',n:'Boeing',p:213.55,mc:'127B',dh:216.00,dl:211.50}
];

let sd = {};
STOCKS.forEach(s => {
  sd[s.t] = {...s, pp:s.p, c:0, cp:0};
});

let el = {};
function cache() {
  el.af = document.getElementById('availFunds');
  el.ta = document.getElementById('totalAssets');
  el.mv = document.getElementById('marketValue');
  el.dpl = document.getElementById('dailyPL');
  el.dplp = document.getElementById('dailyPLPct');
  el.qb = document.getElementById('quoteBody');
  el.pl = document.getElementById('portfolioList');
  el.pc = document.getElementById('posCount');
  el.mdot = document.getElementById('mdot');
  el.mtxt = document.getElementById('mtext');
  el.tb = document.getElementById('tabBuy');
  el.ts = document.getElementById('tabSell');
  el.bm = document.getElementById('btnMarket');
  el.bl = document.getElementById('btnLimit');
  el.lg = document.getElementById('limitGroup');
  el.sc = document.getElementById('stockCode');
  el.lp = document.getElementById('limitPrice');
  el.qt = document.getElementById('quantity');
  el.et = document.getElementById('estTotal');
  el.bpa = document.getElementById('bpAfter');
  el.sb = document.getElementById('submitBtn');
  el.set = document.getElementById('settingsBtn');
  el.sm = document.getElementById('settingsModal');
  el.mc = document.getElementById('modalClose');
  el.tt = document.getElementById('themeToggle');
  el.mt = document.getElementById('marketToggle');
  el.cb = document.getElementById('clearBtn');
  el.to = document.getElementById('toast');
}

function load() {
  try {
    let s = localStorage.getItem('tp_s');
    if (s) {
      let p = JSON.parse(s);
      if (typeof p.funds === 'number') state.funds = p.funds;
      if (p.positions) state.positions = p.positions;
      if (p.trades) state.trades = p.trades;
      if (p.theme) state.theme = p.theme;
      if (typeof p.marketOpen === 'boolean') state.marketOpen = p.marketOpen;
    }
  } catch(e) {}
  document.body.setAttribute('data-theme', state.theme);
}
function save() {
  try { localStorage.setItem('tp_s', JSON.stringify(state)); } catch(e) {}
}

function fmt(n) {
  return '$' + n.toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2});
}

function sim() {
  if (!state.marketOpen) return;
  Object.keys(sd).forEach(t => {
    let s = sd[t];
    let m = (Math.random() - 0.5) * s.p * 0.006;
    s.pp = s.p;
    s.p = Math.max(0.01, s.p + m);
    s.c = s.p - s.pp;
    s.cp = (s.c / s.pp) * 100;
  });
  rq(); ud();
}

function rq() {
  let h = '';
  Object.values(sd).forEach(s => {
    let u = s.c >= 0, sg = u ? '+' : '', cl = u ? 'pos' : 'neg';
    h += '<tr data-tk="' + s.t + '">' +
      '<td><div class="q-ticker">' + s.t + '</div><div class="q-name">' + s.n + '</div></td>' +
      '<td class="q-price">' + s.p.toFixed(2) + '</td>' +
      '<td class="q-change ' + cl + '">' + sg + s.cp.toFixed(2) + '%</td>' +
      '<td class="q-mktcap">' + s.mc + '</td>' +
      '<td class="q-range">' + s.dh.toFixed(2) + '</td>' +
      '<td class="q-range">' + s.dl.toFixed(2) + '</td>' +
      '</tr>';
  });
  el.qb.innerHTML = h;
  el.qb.querySelectorAll('tr').forEach(r => {
    r.addEventListener('click', () => {
      let tk = r.getAttribute('data-tk');
      if (tk) { el.sc.value = tk; calc(); }
    });
  });
}

function rp() {
  let tk = Object.keys(state.positions);
  el.pc.textContent = tk.length + ' position' + (tk.length !== 1 ? 's' : '');
  if (tk.length === 0) {
    el.pl.innerHTML = '<div style="padding:20px;text-align:center;color:var(--text-muted);font-size:13px;font-weight:500;">No open positions</div>';
    return;
  }
  let h = '';
  tk.forEach(t => {
    let p = state.positions[t];
    let cp = sd[t] ? sd[t].p : p.avgCost;
    let v = p.qty * cp;
    let c = p.qty * p.avgCost;
    let pl = v - c;
    let plp = c > 0 ? (pl / c) * 100 : 0;
    let cl = pl >= 0 ? 'pos' : 'neg';
    let sg = pl >= 0 ? '+' : '';
    h += '<div class="portfolio-card">' +
      '<div class="port-left"><div class="port-ticker">' + t + '</div><div class="port-meta">' + p.qty + ' shares @ $' + p.avgCost.toFixed(2) + '</div></div>' +
      '<div class="port-right"><div class="port-value">' + fmt(v) + '</div><div class="port-pl ' + cl + '">' + sg + fmt(pl) + ' (' + sg + plp.toFixed(2) + '%)</div></div>' +
      '</div>';
  });
  el.pl.innerHTML = h;
}

function ud() {
  let mv = 0;
  Object.keys(state.positions).forEach(t => {
    let p = state.positions[t];
    let pr = sd[t] ? sd[t].p : p.avgCost;
    mv += p.qty * pr;
  });
  let ta = state.funds + mv;
  let cb = 0;
  Object.values(state.positions).forEach(p => cb += p.qty * p.avgCost);
  let dpl = mv - cb;
  let dplp = cb > 0 ? (dpl / cb) * 100 : 0;
  el.af.textContent = fmt(state.funds);
  el.ta.textContent = fmt(ta);
  el.mv.textContent = fmt(mv);
  el.dpl.textContent = (dpl >= 0 ? '+' : '') + fmt(dpl);
  el.dplp.textContent = (dplp >= 0 ? '+' : '') + dplp.toFixed(2) + '%';
  el.dpl.className = 'value ' + (dpl >= 0 ? 'pos' : 'neg');
  el.dplp.className = 'sub ' + (dplp >= 0 ? 'pos' : 'neg');
}

function calc() {
  let c = el.sc.value.trim().toUpperCase();
  let q = parseInt(el.qt.value, 10) || 0;
  let l = parseFloat(el.lp.value) || 0;
  let price = 0;
  if (c && sd[c]) {
    price = state.orderType === 'market' ? sd[c].p : (l > 0 ? l : sd[c].p);
  }
  let total = price * q;
  el.et.textContent = fmt(total);
  if (state.tradeSide === 'buy') {
    el.bpa.textContent = fmt(Math.max(0, state.funds - total));
  } else {
    el.bpa.textContent = fmt(state.funds + total);
  }
}

function sts(side) {
  state.tradeSide = side;
  el.tb.classList.toggle('active', side === 'buy');
  el.tb.classList.toggle('buy', side === 'buy');
  el.ts.classList.toggle('active', side === 'sell');
  el.ts.classList.toggle('sell', side === 'sell');
  el.sb.textContent = side === 'buy' ? 'PLACE BUY ORDER' : 'PLACE SELL ORDER';
  el.sb.className = 'submit-btn ' + (side === 'buy' ? 'buy' : 'sell');
  calc();
}

function sto(type) {
  state.orderType = type;
  el.bm.classList.toggle('active', type === 'market');
  el.bl.classList.toggle('active', type === 'limit');
  el.lg.style.display = type === 'limit' ? 'block' : 'none';
  calc();
}

function et() {
  let c = el.sc.value.trim().toUpperCase();
  let q = parseInt(el.qt.value, 10);
  let l = parseFloat(el.lp.value);
  if (!c || !sd[c]) { toast('Invalid symbol'); return; }
  if (!q || q <= 0 || isNaN(q)) { toast('Enter valid quantity'); return; }
  if (state.orderType === 'limit' && (!l || l <= 0 || isNaN(l))) { toast('Enter valid limit price'); return; }
  let s = sd[c];
  let price = state.orderType === 'market' ? s.p : l;
  let total = price * q;
  if (state.tradeSide === 'buy') {
    if (total > state.funds) { toast('Insufficient buying power'); return; }
    state.funds -= total;
    if (!state.positions[c]) state.positions[c] = {qty:0, avgCost:0};
    let pos = state.positions[c];
    let oc = pos.qty * pos.avgCost;
    pos.qty += q;
    pos.avgCost = (oc + total) / pos.qty;
    toast('Bought ' + q + ' ' + c + ' @ ' + fmt(price));
  } else {
    if (!state.positions[c] || state.positions[c].qty < q) { toast('Not enough shares'); return; }
    state.funds += total;
    state.positions[c].qty -= q;
    if (state.positions[c].qty === 0) delete state.positions[c];
    toast('Sold ' + q + ' ' + c + ' @ ' + fmt(price));
  }
  state.trades.push({side:state.tradeSide, ticker:c, qty:q, price:price, total:total, time:new Date().toISOString(), type:state.orderType});
  save(); rp(); ud();
  el.sc.value = ''; el.qt.value = ''; el.lp.value = ''; calc();
}

function os() {
  el.sm.classList.add('open');
  el.tt.classList.toggle('on', state.theme === 'dark');
  el.mt.classList.toggle('on', state.marketOpen);
}
function cs() { el.sm.classList.remove('open'); }
function tt() {
  state.theme = state.theme === 'dark' ? 'light' : 'dark';
  document.body.setAttribute('data-theme', state.theme);
  el.tt.classList.toggle('on', state.theme === 'dark');
  save();
}
function tm() {
  state.marketOpen = !state.marketOpen;
  el.mt.classList.toggle('on', state.marketOpen);
  umb(); save();
}
function umb() {
  if (state.marketOpen) { el.mdot.classList.remove('closed'); el.mtxt.textContent = 'OPEN'; }
  else { el.mdot.classList.add('closed'); el.mtxt.textContent = 'CLOSED'; }
}
function cr() {
  if (!confirm('Clear all positions and reset to $25,000?')) return;
  state.funds = DF; state.positions = {}; state.trades = [];
  save(); rp(); ud(); cs(); toast('All records cleared');
}
function toast(m) {
  el.to.textContent = m; el.to.classList.add('show');
  setTimeout(() => el.to.classList.remove('show'), 2800);
}

function bind() {
  el.tb.addEventListener('click', () => sts('buy'));
  el.ts.addEventListener('click', () => sts('sell'));
  el.bm.addEventListener('click', () => sto('market'));
  el.bl.addEventListener('click', () => sto('limit'));
  el.sb.addEventListener('click', et);
  el.set.addEventListener('click', os);
  el.mc.addEventListener('click', cs);
  el.sm.addEventListener('click', e => { if (e.target === el.sm) cs(); });
  el.tt.addEventListener('click', tt);
  el.mt.addEventListener('click', tm);
  el.cb.addEventListener('click', cr);
  [el.sc, el.qt, el.lp].forEach(inp => {
    inp.addEventListener('input', calc);
  });
}

function init() {
  cache(); load(); umb();
  rq(); rp(); ud(); bind();
  setInterval(sim, 3000);
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', init);
} else { init(); }
})();
</script>
</body>
</html>
